// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  KITCHEN
  DISPATCH
  DRIVER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  defaultDriverCompanies Company[] @relation("CompanyDefaultDriver")
}

enum DishTemperature {
  HOT
  COLD
}

model Dish {
  id                   String          @id @default(cuid())
  name                 String
  description          String?
  imageUrl             String?
  sku                  String          @unique
  temperature          DishTemperature
  costPrice            Decimal         @db.Decimal(10, 2)
  minimumOrderQuantity Int?
  kitchenStationId     String?
  kitchenStation       KitchenStation? @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  allergens           Allergen[]
  dietaryTags         DietaryTag[]
  optionGroups        OptionGroup[]
  categoryDishes      CategoryDish[]
  companyHiddenDishes CompanyHiddenDish[]
  dishPrices          DishPrice[]

  @@index([name])
  @@index([sku])
  @@index([isActive])
  @@index([kitchenStationId])
}

model Option {
  id        String   @id @default(cuid())
  name      String
  costPrice Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allergens          Allergen[]
  dietaryTags        DietaryTag[]
  optionGroupOptions OptionGroupOption[]
  optionPortions     OptionPortion[]
  optionPrices       OptionPrice[]

  @@index([name])
  @@index([isActive])
}

model OptionGroup {
  id           String   @id @default(cuid())
  dishId       String
  dish         Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  name         String
  isRequired   Boolean  @default(false)
  displayOrder Int
  usesPortions Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  optionGroupOptions  OptionGroupOption[]
  optionGroupPortions OptionGroupPortion[]

  @@unique([dishId, displayOrder])
  @@index([dishId])
}

model OptionGroupOption {
  id            String      @id @default(cuid())
  optionGroupId String
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  optionId      String
  option        Option      @relation(fields: [optionId], references: [id], onDelete: Restrict)
  displayOrder  Int
  createdAt     DateTime    @default(now())

  @@unique([optionGroupId, optionId])
  @@unique([optionGroupId, displayOrder])
  @@index([optionGroupId])
  @@index([optionId])
}

model Allergen {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dishes    Dish[]
  options   Option[]
  employees Employee[]

  @@index([name])
  @@index([isActive])
}

model DietaryTag {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dishes    Dish[]
  options   Option[]
  employees Employee[]

  @@index([name])
  @@index([isActive])
}

model KitchenStation {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dishes Dish[]

  @@index([name])
  @@index([isActive])
}

model PortionSize {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  optionGroupPortions OptionGroupPortion[]
  optionPortions      OptionPortion[]

  @@index([name])
  @@index([isActive])
}

model OptionGroupPortion {
  id            String      @id @default(cuid())
  optionGroupId String
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  portionSizeId String
  portionSize   PortionSize @relation(fields: [portionSizeId], references: [id], onDelete: Restrict)
  displayOrder  Int
  createdAt     DateTime    @default(now())

  @@unique([optionGroupId, portionSizeId])
  @@unique([optionGroupId, displayOrder])
  @@index([optionGroupId])
  @@index([portionSizeId])
}

model OptionPortion {
  id            String      @id @default(cuid())
  optionId      String
  option        Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  portionSizeId String
  portionSize   PortionSize @relation(fields: [portionSizeId], references: [id], onDelete: Restrict)
  extraCharge   Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([optionId, portionSizeId])
  @@index([optionId])
  @@index([portionSizeId])
}

model MenuCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  displayOrder Int
  isActive     Boolean  @default(true)
  isSecret     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryDishes          CategoryDish[]
  companyHiddenCategories CompanyHiddenCategory[]

  @@index([displayOrder])
  @@index([isActive])
  @@index([isSecret])
}

model CategoryDish {
  id           String       @id @default(cuid())
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dishId       String
  dish         Dish         @relation(fields: [dishId], references: [id], onDelete: Cascade)
  displayOrder Int
  createdAt    DateTime     @default(now())

  @@unique([categoryId, dishId])
  @@unique([categoryId, displayOrder])
  @@index([categoryId])
  @@index([dishId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Billing Contact
  billingContactName  String?
  billingContactEmail String?
  billingContactPhone String?

  // Calendar
  workingDays DayOfWeek[] @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY])

  // Delivery Defaults
  defaultDeliveryTime        String?
  leaveKitchenMinutes        Int     @default(60)
  defaultPackagingType       String?
  standingDriverInstructions String?
  defaultDriverId            String?
  defaultDriver              User?   @relation("CompanyDefaultDriver", fields: [defaultDriverId], references: [id], onDelete: SetNull)

  // Company Owner
  ownerId String?
  owner   Employee? @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Relations
  employees               Employee[]               @relation("CompanyEmployees")
  emailDomains            CompanyEmailDomain[]
  deliveryAddresses       DeliveryAddress[]
  holidays                CompanyHoliday[]
  companyHiddenCategories CompanyHiddenCategory[]
  companyHiddenDishes     CompanyHiddenDish[]
  priceTierId             String?
  priceTier               PriceTier?               @relation(fields: [priceTierId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([isActive])
  @@index([priceTierId])
  @@index([ownerId])
  @@index([defaultDriverId])
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  companyId String
  company   Company  @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)

  // Business Permission Flags
  canChooseDeliveryAddress Boolean @default(false)
  canChangeDeliveryTime    Boolean @default(false)
  canChangePackaging       Boolean @default(false)

  // Allergies & Dietary Preferences (Catalogue Reference Data)
  allergens   Allergen[]
  dietaryTags DietaryTag[]

  // Owner back-relation
  ownedCompanies Company[] @relation("CompanyOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([isActive])
}

model CompanyEmailDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([companyId])
}

model DeliveryAddress {
  id                   String   @id @default(cuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label                String?
  street               String
  unit                 String?
  city                 String
  postcode             String
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([companyId])
}

model CompanyHoliday {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, date])
  @@index([companyId])
}

model CompanyHiddenCategory {
  id         String       @id @default(cuid())
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([companyId, categoryId])
  @@index([companyId])
  @@index([categoryId])
}

model CompanyHiddenDish {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([companyId, dishId])
  @@index([companyId])
  @@index([dishId])
}

enum PriceDerivationType {
  MANUAL
  COST_MULTIPLIER
  TIER_PERCENTAGE
}

model PriceTier {
  id             String              @id @default(cuid())
  name           String              @unique
  description    String?
  derivationType PriceDerivationType
  baseTierId     String?
  baseTier       PriceTier?          @relation("TierHierarchy", fields: [baseTierId], references: [id], onDelete: Restrict)
  derivedTiers   PriceTier[]         @relation("TierHierarchy")
  multiplier     Decimal?            @db.Decimal(10, 4)
  percentage     Decimal?            @db.Decimal(10, 2)
  isDefault      Boolean             @default(false)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  dishPrices   DishPrice[]
  optionPrices OptionPrice[]
  companies    Company[]

  @@index([name])
  @@index([isDefault])
  @@index([isActive])
  @@index([baseTierId])
}

model DishPrice {
  id        String    @id @default(cuid())
  tierId    String
  priceTier PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  dishId    String
  dish      Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  price     Decimal   @db.Decimal(10, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tierId, dishId])
  @@index([tierId])
  @@index([dishId])
}

model OptionPrice {
  id        String    @id @default(cuid())
  tierId    String
  priceTier PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  optionId  String
  option    Option    @relation(fields: [optionId], references: [id], onDelete: Cascade)
  price     Decimal   @db.Decimal(10, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tierId, optionId])
  @@index([tierId])
  @@index([optionId])
}

