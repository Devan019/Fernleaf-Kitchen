generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String               @id @default(cuid())
  name                   String
  email                  String               @unique
  passwordHash           String
  role                   UserRole
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  defaultDriverCompanies Company[]            @relation("CompanyDefaultDriver")
  Order                  Order[]
  OrderStatusHistory     OrderStatusHistory[]
  kitchenUnitsStarted    KitchenUnit[]        @relation("KitchenUnitStartedBy")
  kitchenUnitsCompleted  KitchenUnit[]        @relation("KitchenUnitCompletedBy")
  driverDrops            DeliveryDrop[]       @relation("DriverDrops")
  dropStatusChanges      DropStatusHistory[]
  billingAdjustments     BillingAdjustment[]
}

model Dish {
  id                   String              @id @default(cuid())
  name                 String
  description          String?
  imageUrl             String?
  sku                  String              @unique
  temperature          DishTemperature
  costPrice            Decimal             @db.Decimal(10, 2)
  minimumOrderQuantity Int?
  kitchenStationId     String?
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  categoryDishes       CategoryDish[]
  companyHiddenDishes  CompanyHiddenDish[]
  kitchenStation       KitchenStation?     @relation(fields: [kitchenStationId], references: [id])
  dishPrices           DishPrice[]
  optionGroups         OptionGroup[]
  OrderLine            OrderLine[]
  allergens            Allergen[]          @relation("AllergenToDish")
  dietaryTags          DietaryTag[]        @relation("DietaryTagToDish")

  @@index([name])
  @@index([sku])
  @@index([isActive])
  @@index([kitchenStationId])
}

model Option {
  id                     String                   @id @default(cuid())
  name                   String
  costPrice              Decimal                  @db.Decimal(10, 2)
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  optionGroupOptions     OptionGroupOption[]
  optionPortions         OptionPortion[]
  optionPrices           OptionPrice[]
  OrderCombinationOption OrderCombinationOption[]
  allergens              Allergen[]               @relation("AllergenToOption")
  dietaryTags            DietaryTag[]             @relation("DietaryTagToOption")

  @@index([name])
  @@index([isActive])
}

model OptionGroup {
  id                  String               @id @default(cuid())
  dishId              String
  name                String
  isRequired          Boolean              @default(false)
  displayOrder        Int
  usesPortions        Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  dish                Dish                 @relation(fields: [dishId], references: [id], onDelete: Cascade)
  optionGroupOptions  OptionGroupOption[]
  optionGroupPortions OptionGroupPortion[]

  @@unique([dishId, displayOrder])
  @@index([dishId])
}

model OptionGroupOption {
  id            String      @id @default(cuid())
  optionGroupId String
  optionId      String
  displayOrder  Int
  createdAt     DateTime    @default(now())
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  option        Option      @relation(fields: [optionId], references: [id])

  @@unique([optionGroupId, optionId])
  @@unique([optionGroupId, displayOrder])
  @@index([optionGroupId])
  @@index([optionId])
}

model Allergen {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  dishes    Dish[]     @relation("AllergenToDish")
  employees Employee[] @relation("AllergenToEmployee")
  options   Option[]   @relation("AllergenToOption")

  @@index([name])
  @@index([isActive])
}

model DietaryTag {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  dishes    Dish[]     @relation("DietaryTagToDish")
  employees Employee[] @relation("DietaryTagToEmployee")
  options   Option[]   @relation("DietaryTagToOption")

  @@index([name])
  @@index([isActive])
}

model KitchenStation {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  dishes    Dish[]
  kitchenUnits KitchenUnit[]

  @@index([name])
  @@index([isActive])
}

model PortionSize {
  id                  String               @id @default(cuid())
  name                String               @unique
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  optionGroupPortions OptionGroupPortion[]
  optionPortions      OptionPortion[]

  @@index([name])
  @@index([isActive])
}

model OptionGroupPortion {
  id            String      @id @default(cuid())
  optionGroupId String
  portionSizeId String
  displayOrder  Int
  createdAt     DateTime    @default(now())
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  portionSize   PortionSize @relation(fields: [portionSizeId], references: [id])

  @@unique([optionGroupId, portionSizeId])
  @@unique([optionGroupId, displayOrder])
  @@index([optionGroupId])
  @@index([portionSizeId])
}

model OptionPortion {
  id            String      @id @default(cuid())
  optionId      String
  portionSizeId String
  extraCharge   Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  option        Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  portionSize   PortionSize @relation(fields: [portionSizeId], references: [id])

  @@unique([optionId, portionSizeId])
  @@index([optionId])
  @@index([portionSizeId])
}

model MenuCategory {
  id                      String                  @id @default(cuid())
  name                    String                  @unique
  displayOrder            Int
  isActive                Boolean                 @default(true)
  isSecret                Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  categoryDishes          CategoryDish[]
  companyHiddenCategories CompanyHiddenCategory[]

  @@index([displayOrder])
  @@index([isActive])
  @@index([isSecret])
}

model CategoryDish {
  id           String       @id @default(cuid())
  categoryId   String
  dishId       String
  displayOrder Int
  createdAt    DateTime     @default(now())
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dish         Dish         @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([categoryId, dishId])
  @@unique([categoryId, displayOrder])
  @@index([categoryId])
  @@index([dishId])
}

model Company {
  id                         String                  @id @default(cuid())
  name                       String                  @unique
  isActive                   Boolean                 @default(true)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  priceTierId                String?
  billingContactEmail        String?
  billingContactName         String?
  billingContactPhone        String?
  defaultDeliveryTime        String?
  defaultDriverId            String?
  defaultPackagingType       String?
  leaveKitchenMinutes        Int                     @default(60)
  ownerId                    String?
  standingDriverInstructions String?
  workingDays                DayOfWeek[]             @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY])
  defaultDriver              User?                   @relation("CompanyDefaultDriver", fields: [defaultDriverId], references: [id])
  owner                      Employee?               @relation("CompanyOwner", fields: [ownerId], references: [id])
  priceTier                  PriceTier?              @relation(fields: [priceTierId], references: [id])
  emailDomains               CompanyEmailDomain[]
  companyHiddenCategories    CompanyHiddenCategory[]
  companyHiddenDishes        CompanyHiddenDish[]
  holidays                   CompanyHoliday[]
  deliveryAddresses          DeliveryAddress[]
  employees                  Employee[]              @relation("CompanyEmployees")
  Order                      Order[]
  deliveryDrops              DeliveryDrop[]
  invoices                   Invoice[]

  @@index([name])
  @@index([isActive])
  @@index([priceTierId])
  @@index([ownerId])
  @@index([defaultDriverId])
}

model Employee {
  id                       String       @id @default(cuid())
  name                     String
  email                    String?      @unique
  companyId                String
  isActive                 Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  canChangeDeliveryTime    Boolean      @default(false)
  canChangePackaging       Boolean      @default(false)
  canChooseDeliveryAddress Boolean      @default(false)
  ownedCompanies           Company[]    @relation("CompanyOwner")
  company                  Company      @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: Cascade)
  Order                    Order[]
  allergens                Allergen[]   @relation("AllergenToEmployee")
  dietaryTags              DietaryTag[] @relation("DietaryTagToEmployee")

  @@index([companyId])
  @@index([isActive])
}

model CompanyEmailDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  companyId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model DeliveryAddress {
  id                   String   @id @default(cuid())
  companyId            String
  label                String?
  street               String
  unit                 String?
  city                 String
  postcode             String
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyHoliday {
  id          String   @id @default(cuid())
  companyId   String
  date        DateTime @db.Date
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
}

model CompanyHiddenCategory {
  id         String       @id @default(cuid())
  companyId  String
  categoryId String
  createdAt  DateTime     @default(now())
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, categoryId])
  @@index([companyId])
  @@index([categoryId])
}

model CompanyHiddenDish {
  id        String   @id @default(cuid())
  companyId String
  dishId    String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([companyId, dishId])
  @@index([companyId])
  @@index([dishId])
}

model PriceTier {
  id             String              @id @default(cuid())
  name           String              @unique
  description    String?
  derivationType PriceDerivationType
  baseTierId     String?
  multiplier     Decimal?            @db.Decimal(10, 4)
  percentage     Decimal?            @db.Decimal(10, 2)
  isDefault      Boolean             @default(false)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  companies      Company[]
  dishPrices     DishPrice[]
  optionPrices   OptionPrice[]
  baseTier       PriceTier?          @relation("TierHierarchy", fields: [baseTierId], references: [id], onDelete: Restrict)
  derivedTiers   PriceTier[]         @relation("TierHierarchy")

  @@index([name])
  @@index([isDefault])
  @@index([isActive])
  @@index([baseTierId])
}

model DishPrice {
  id        String    @id @default(cuid())
  tierId    String
  dishId    String
  price     Decimal   @db.Decimal(10, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  dish      Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  priceTier PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([tierId, dishId])
  @@index([tierId])
  @@index([dishId])
}

model OptionPrice {
  id        String    @id @default(cuid())
  tierId    String
  optionId  String
  price     Decimal   @db.Decimal(10, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  option    Option    @relation(fields: [optionId], references: [id], onDelete: Cascade)
  priceTier PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([tierId, optionId])
  @@index([tierId])
  @@index([optionId])
}

model KitchenHoliday {
  id          String   @id
  date        DateTime @unique @db.Date
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([date])
}

model KitchenSetting {
  id          String   @id
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([key])
}

model Order {
  id                   String               @id
  orderNumber          String               @unique
  employeeId           String
  companyId            String
  deliveryDate         DateTime             @db.Date
  deliveryTime         String
  status               OrderStatus          @default(DRAFT)
  packagingType        String
  deliveryAddressId    String?
  deliveryAddressLabel String?
  deliveryStreet       String
  deliveryUnit         String?
  deliveryCity         String
  deliveryPostcode     String
  deliveryInstructions String?
  subtotal             Decimal              @db.Decimal(10, 2)
  total                Decimal              @db.Decimal(10, 2)
  createdByUserId      String?
  isInvoiced             Boolean              @default(false)
  placedAt               DateTime?
  confirmedAt            DateTime?
  deliveredAt            DateTime?
  cancelledAt            DateTime?
  rejectedAt             DateTime?
  kitchenStartedAt       DateTime?
  kitchenReadyAt         DateTime?
  plannedKitchenReadyAt  DateTime?
  plannedDispatchReadyAt DateTime?
  dropId                 String?
  fulfillmentStatus      FulfillmentStatus    @default(KITCHEN_PENDING)
  dispatchReadyAt        DateTime?
  outForDeliveryAt       DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime
  Company                Company              @relation(fields: [companyId], references: [id])
  User                   User?                @relation(fields: [createdByUserId], references: [id])
  Employee               Employee             @relation(fields: [employeeId], references: [id])
  OrderLine              OrderLine[]
  OrderStatusHistory     OrderStatusHistory[]
  kitchenUnits           KitchenUnit[]
  deliveryDrop           DeliveryDrop?        @relation(fields: [dropId], references: [id], onDelete: SetNull)
  invoiceLine            InvoiceLine?
  billingAdjustments     BillingAdjustment[]

  @@index([companyId])
  @@index([createdAt])
  @@index([deliveryDate])
  @@index([employeeId])
  @@index([isInvoiced])
  @@index([status])
  @@index([plannedKitchenReadyAt])
  @@index([kitchenReadyAt])
  @@index([dropId])
  @@index([fulfillmentStatus])
}

model OrderCombinationOption {
  id                      String               @id
  combinationId           String
  optionGroupId           String?
  optionGroupNameSnapshot String?
  optionId                String
  optionNameSnapshot      String
  unitPrice               Decimal              @db.Decimal(10, 2)
  portionSizeId           String?
  portionSizeNameSnapshot String?
  portionExtraCharge      Decimal              @default(0) @db.Decimal(10, 2)
  finalPrice              Decimal              @db.Decimal(10, 2)
  createdAt               DateTime             @default(now())
  OrderLineCombination    OrderLineCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  Option                  Option               @relation(fields: [optionId], references: [id])

  @@index([combinationId])
  @@index([optionId])
}

model OrderLine {
  id                   String                 @id
  orderId              String
  dishId               String
  dishNameSnapshot     String
  dishSkuSnapshot      String?
  unitPrice            Decimal                @db.Decimal(10, 2)
  quantity             Int
  lineTotal            Decimal                @db.Decimal(10, 2)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  Dish                 Dish                   @relation(fields: [dishId], references: [id])
  Order                Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  OrderLineCombination OrderLineCombination[]
  kitchenUnits         KitchenUnit[]

  @@index([dishId])
  @@index([orderId])
}

model OrderLineCombination {
  id                     String                   @id
  orderLineId            String
  quantity               Int
  unitPrice              Decimal                  @db.Decimal(10, 2)
  combinationTotal       Decimal                  @db.Decimal(10, 2)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  OrderCombinationOption OrderCombinationOption[]
  OrderLine              OrderLine                @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  kitchenUnit            KitchenUnit?

  @@index([orderLineId])
}

model OrderStatusHistory {
  id              String       @id
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime     @default(now())
  User            User?        @relation(fields: [changedByUserId], references: [id])
  Order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([orderId])
}

enum UserRole {
  ADMIN
  KITCHEN
  DISPATCH
  DRIVER
}

enum DishTemperature {
  HOT
  COLD
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PriceDerivationType {
  MANUAL
  COST_MULTIPLIER
  TIER_PERCENTAGE
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  DELIVERED
  CANCELLED
  REJECTED
}

enum KitchenUnitStatus {
  PENDING
  STARTED
  DONE
}

model KitchenUnit {
  id                String               @id @default(cuid())
  orderId           String
  orderLineId       String
  combinationId     String               @unique
  kitchenStationId  String?
  status            KitchenUnitStatus    @default(PENDING)
  quantity          Int
  startedAt         DateTime?
  completedAt       DateTime?
  startedByUserId   String?
  completedByUserId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine         OrderLine            @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  combination       OrderLineCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  kitchenStation    KitchenStation?      @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  startedByUser     User?                @relation("KitchenUnitStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  completedByUser   User?                @relation("KitchenUnitCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderLineId])
  @@index([kitchenStationId])
  @@index([status])
}

enum DeliveryDropStatus {
  KITCHEN_READY
  DISPATCH_READY
  OUT_FOR_DELIVERY
  DELIVERED
}

enum FulfillmentStatus {
  KITCHEN_PENDING
  KITCHEN_READY
  DISPATCH_READY
  OUT_FOR_DELIVERY
  DELIVERED
}

model DeliveryDrop {
  id                   String              @id @default(cuid())
  companyId            String
  deliveryDate         DateTime            @db.Date
  deliveryTime         String
  groupingKey          String              @unique

  deliveryStreet       String
  deliveryUnit         String?
  deliveryCity         String
  deliveryPostcode     String
  deliveryInstructions String?

  status               DeliveryDropStatus  @default(KITCHEN_READY)
  driverId             String?

  dispatchReadyAt      DateTime?
  outForDeliveryAt     DateTime?
  deliveredAt          DateTime?

  deliveredNote        String?
  deliveredPhotoUrl    String?
  isOnTime             Boolean?

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  company              Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  driver               User?               @relation("DriverDrops", fields: [driverId], references: [id], onDelete: SetNull)
  orders               Order[]
  statusHistory        DropStatusHistory[]

  @@index([deliveryDate])
  @@index([status])
  @@index([driverId])
  @@index([companyId, deliveryDate, deliveryTime])
}

model DropStatusHistory {
  id              String              @id @default(cuid())
  dropId          String
  fromStatus      DeliveryDropStatus?
  toStatus        DeliveryDropStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime            @default(now())

  drop            DeliveryDrop        @relation(fields: [dropId], references: [id], onDelete: Cascade)
  changedByUser   User?               @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([dropId])
  @@index([createdAt])
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum BillingAdjustmentType {
  DEBIT
  CREDIT
}

model Invoice {
  id              String              @id @default(cuid())
  invoiceNumber   String              @unique
  companyId       String
  status          InvoiceStatus       @default(OPEN)
  issuedAt        DateTime            @default(now())
  paidAt          DateTime?
  subtotal        Decimal             @db.Decimal(12, 2)
  adjustmentTotal Decimal             @default(0) @db.Decimal(12, 2)
  total           Decimal             @db.Decimal(12, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lines           InvoiceLine[]
  adjustments     BillingAdjustment[]

  @@index([companyId])
  @@index([status])
  @@index([issuedAt])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  orderId     String   @unique
  description String
  quantity    Int      @default(1)
  unitAmount  Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model BillingAdjustment {
  id              String                @id @default(cuid())
  invoiceId       String
  orderId         String
  type            BillingAdjustmentType
  amount          Decimal               @db.Decimal(12, 2)
  reason          String
  createdByUserId String?
  createdAt       DateTime              @default(now())

  invoice         Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdByUser   User?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([orderId])
}


